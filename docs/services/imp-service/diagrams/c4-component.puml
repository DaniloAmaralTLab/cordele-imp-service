@startuml imp-c4-component
' C4 Level 3 — Component — Import (IMP) — hexagonal (node): modules/imp + domain + infrastructure
title Cordelê — Import (IMP) — Component (hexagonal-node)

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #24608A
}

rectangle "modules/imp (application)" as App #E8F0FE {
  rectangle "ImpController\n(POST/GET endpoints)" as Ctrl
  rectangle "ImportManuscriptUseCase\n(validate > store > parse > persist > emit)" as UC
  rectangle "dto/ (request/response)" as Dto
}

rectangle "domain (no @nestjs, no @prisma)" as Domain {
  rectangle "Manuscrito (aggregate root)\n+ ContentTree value objects\n(Chapter/Section/Paragraph/Image/UnparsedSegment)" as Agg
  rectangle "Ports:\nManuscriptParserPort\nManuscriptRepositoryPort\nFileStoragePort" as Ports
}

rectangle "infrastructure (adapters)" as Infra {
  rectangle "PrismaManuscritoRepository\n+ mappers" as Repo
  rectangle "DocxMammothAdapter" as Docx
  rectangle "MarkdownRemarkAdapter" as Md
  rectangle "FileStorageAdapter\n(local-disk / S3)" as Store
}

rectangle "PROJ inbound ports\n(in-process)" as Proj

Ctrl --> UC
Ctrl --> Dto
UC --> Agg
UC --> Ports
UC --> Proj : create/validate project (D-C)
Repo ..|> Ports : implements ManuscriptRepositoryPort
Docx ..|> Ports : implements ManuscriptParserPort (docx)
Md   ..|> Ports : implements ManuscriptParserPort (markdown)
Store ..|> Ports : implements FileStoragePort
Repo --> Agg : maps rows <-> aggregate

note bottom of Domain
  Dependency rule points inward.
  Parser selected per formato behind the port;
  use case never names mammoth/remark.
end note
@enduml
