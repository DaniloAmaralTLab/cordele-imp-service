@startuml imp-c4-container
' C4 Level 2 — Container — Import (IMP)
title Cordelê — Import (IMP) — Container

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #24608A
}

rectangle "BFF (NestJS)\nsingle entry point" as BFF
rectangle "Cordelê backend (NestJS 11 monolith)" as App {
  rectangle "ImpModule\n(imp bounded context)" as IMP #E8F0FE
  rectangle "ProjModule\n(PROJ context)" as PROJ
}
database "PostgreSQL 16\n(Prisma; tenant schema emp_<slug>)" as PG
rectangle "File Storage\n(FileStoragePort adapter:\nlocal disk / S3)" as Storage

BFF --> IMP : POST /api/imp/manuscripts (multipart)\nGET /api/imp/manuscripts/{id}
IMP --> PROJ : in-process DI\n(CreateProjetoEditorialUseCase,\nProjetoEditorialLookup)
IMP --> PG : Prisma repository\n(manuscrito, tenant schema)
IMP --> Storage : put/get/delete\n(tenant-scoped keys)
IMP ..> PROJ : ManuscriptImported\n(in-process event emitter)

note right of IMP
  No Kafka/Artemis (messaging.enabled=false).
  No Eureka/gateway (single monolith).
  epubcheck (JVM) belongs to PUB, not IMP.
end note
@enduml
