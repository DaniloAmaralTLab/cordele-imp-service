# imp-service — local environment (D-544 / D-545).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=*

# Prisma (D-545)
DATABASE_URL=postgresql://cordele:cordele@localhost:5434/cordele_dev?schema=public

# Auth
JWT_ISSUER_URI=http://localhost:8180/realms/cordele
JWT_AUDIENCE=imp-service

# FileStorage — adapter selection (P8)
# Valores válidos: local (default, sem dependência de nuvem) | s3
FILE_STORAGE_ADAPTER=local

# LocalDiskAdapter (somente quando FILE_STORAGE_ADAPTER=local)
FILE_STORAGE_BASE_DIR=/tmp/cordele-files

# S3Adapter (somente quando FILE_STORAGE_ADAPTER=s3)
# Compatible com AWS S3, MinIO ou qualquer endpoint S3-compatible.
S3_BUCKET=cordele-manuscripts
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key-id
S3_SECRET_KEY=your-secret-access-key
