// Prisma schema for imp-service (cordele).
// Multi-tenancy (multi-empresa): every tenant-scoped table carries a
// `empresaId` discriminator. It is part of every unique constraint and is
// the leading index column, so the tenant filter is always index-covered.
// The application layer must set it from the request context — Prisma has no
// row-level security, so a missing filter is a data leak, not a slow query.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "tracing"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  output          = "../src/infrastructure/prisma-client"
}

model Manuscrito {
  id                   String    @id @default(uuid()) @db.Uuid
  projetoId            String    @map("projeto_id") @db.Uuid
  nomeArquivo          String    @map("nome_arquivo")
  formato              String
  status               String    @default("imported")
  totalCapitulos       Int       @default(0) @map("total_capitulos")
  totalImagens         Int       @default(0) @map("total_imagens")
  trechosNaoParseados  Int       @default(0) @map("trechos_nao_parseados")
  estrutura            Json
  contentHash          String?   @map("content_hash") @db.Char(64)
  binarioStorageKey    String    @map("binario_storage_key")
  tamanhoBytes         BigInt    @map("tamanho_bytes")
  criadoEm             DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@map("manuscrito")
}

model SegmentoCuradoria {
  id            String    @id @default(uuid()) @db.Uuid
  manuscritoId  String    @map("manuscrito_id") @db.Uuid
  segmentoId    String    @map("segmento_id")
  acao          String    @default("ignorado")
  criadoPor     String    @map("criado_por")
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@unique([manuscritoId, segmentoId])
  @@map("segmento_curadoria")
}
